# Leaseproof environment. Copy to .env.local and fill in.
# Names only — never commit real values. See README.md for what each one does.

# --- Clerk: landlord (Google + email) and renter accounts -------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# --- Neon Postgres ----------------------------------------------------------
# Pooled connection string.
DATABASE_URL=

# --- Stripe: applicant-paid $24.99 screening fee ----------------------------
# Test mode only for now (sk_test_...). Webhook endpoint: /api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Vercel Blob: applicant ID and income documents (stored private) --------
BLOB_READ_WRITE_TOKEN=

# --- Leaseproof -------------------------------------------------------------
# 1 = seed sample listings and leave /dashboard ungated. NEVER set in production.
LEASEPROOF_DEMO=
# Comma-separated landlord emails (case-insensitive). Production: empty = nobody
# new gets a desk. Demo or Vercel Preview: unset falls back to
# michaelgkwok@gmail.com and aaisuzukillc@gmail.com. Applicants are not on this list.
LEASEPROOF_BETA_EMAILS=
# 1 = allow a live Stripe key to charge $24.99. Defaults off. Do not set until
# counsel clears Cal. Civ. Code § 1950.6. Test keys work without this.
LEASEPROOF_LIVE_FEES=
# Absolute origin for Stripe return URLs. Falls back to VERCEL_URL, then localhost.
NEXT_PUBLIC_APP_URL=
